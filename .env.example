# AstroMed by Team Antares: final hackathon configuration.
ASTROMED_DEMO=1
# Keep this value equal to API_KEY on the ESP32 and api_key in simulator/config.json.
ASTROMED_API_KEY=spacehealth-dev-key-2026
ASTROMED_CORS_ORIGINS=*
# Optional database override. By default, an existing spacehealth.db is reused;
# a new installation creates astromed.db. Previous SPACEHEALTH_* variables still work.
# ASTROMED_DATABASE_URL=sqlite:///./astromed.db
