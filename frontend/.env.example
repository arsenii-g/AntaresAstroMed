# Copia este archivo a .env.local y ajústalo. Nada de aquí es secreto:
# todo lo que empieza por VITE_ acaba en el JavaScript del navegador.

# Dónde escucha la API en desarrollo (Vite le reenvía /api y el WebSocket).
API_PROXY_TARGET=http://localhost:8000

# Ruta del WebSocket ④ en la API. Pendiente de confirmar con Jesus.
VITE_WS_PATH=/ws

# URL completa del WebSocket, solo si la API no está detrás del mismo host.
# VITE_WS_URL=ws://localhost:8000/ws

# Base de la API si no va por el proxy de Vite (por ejemplo en producción).
# VITE_API_BASE=http://localhost:8000

# Clave X-API-Key, si la API también la pide a la web.
# VITE_API_KEY=demo

# Tripulante que se muestra al abrir, hasta que llegue un crew_checkin.
# Sin definir, la web espera a que alguien pase la tarjeta.
# También vale ?crew=<UID> en la URL.
# VITE_DEFAULT_CREW=
